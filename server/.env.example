# Campaign Notes server environment variables
# Copy this file to .env and fill in real values before running the server.

# PostgreSQL connection string used by Prisma.
# Example for local Docker Compose:
DATABASE_URL="[db url]"

# Secret used to sign and verify JWT auth tokens.
# Generate a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="change-me-to-a-random-secret"

# Node environment (development | production)
NODE_ENV="development"

# Port the API server listens on
PORT="3001"
